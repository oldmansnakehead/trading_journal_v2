{
  "name": "trading_journal_v2",
  "version": "1.0.1",
  "description": "An Electron application with Vue and TypeScript",
  "main": "./out/main/index.js",
  "author": "dickhorror",
  "homepage": "https://electron-vite.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/oldmansnakehead/trading_journal_v2.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build && node scripts/copy-migrations.js",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "build:publish": "npm run build && electron-builder --win --publish always",
    "release": "npm run build && electron-builder --win --publish always",
    "release:draft": "npm run build && electron-builder --win --publish onTagOrDraft",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "seed": "node scripts/seed.js",
    "seed:generate": "node scripts/generate-seed-json.js",
    "icons": "node scripts/build-icons.js",
    "test": "vitest run --project=unit",
    "test:unit": "vitest run --project=unit",
    "test:e2e": "playwright test && node scripts/generate-pdf-report.js"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@phosphor-icons/web": "^2.1.2",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.11.1",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "crypto": "^1.0.1",
    "drizzle-orm": "^0.45.4",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "html-to-image": "^1.11.13",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.3",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-onboarding": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/vue3-vite": "^10.6.1",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/extract-zip": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/pdfkit": "^0.17.6",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "autoprefixer": "^10.6.1",
    "drizzle-kit": "^0.31.11",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-storybook": "^10.6.1",
    "eslint-plugin-vue": "^10.6.2",
    "pdfkit": "^0.20.2",
    "playwright": "latest",
    "postcss": "^8.5.29",
    "prettier": "^3.7.4",
    "storybook": "^10.6.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "latest",
    "vue": "^3.5.25",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.6"
  }
}
